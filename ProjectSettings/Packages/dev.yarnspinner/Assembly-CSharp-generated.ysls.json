{"version":2,"commands":[{"yarnName":"scene_load","definitionName":"SceneLoad","fileName":"Sunrise Studio/Assets/Scripts/YarnCommands.cs","documentation":"<<scene_load \"Dorm\" \"Morning\">>: does nothing when the location is this scene, so a node can open with the scene it belongs to. Otherwise it loads that scene and the dialogue never continues here: the rest of the node (such as a <<jump>>) is left to the next scene, which plays its own start node. Location names ignore case, spaces, and underscores, so \"music_room\" loads the MusicRoom scene.","language":"csharp","async":false,"containsErrors":false,"location":{"start":{"line":89,"character":4},"end":{"line":114,"character":5}},"parameters":[{"name":"location","isParamsArray":false,"type":"string"},{"name":"timeOfDay","isParamsArray":false,"type":"string"}]},{"yarnName":"sfx","definitionName":"PlaySound","fileName":"Sunrise Studio/Assets/Scripts/YarnCommands.cs","language":"csharp","async":false,"containsErrors":false,"location":{"start":{"line":149,"character":4},"end":{"line":163,"character":5}},"parameters":[{"name":"soundName","isParamsArray":false,"type":"string"}]},{"yarnName":"freeze_frame","definitionName":"PlayFreezeFrame","fileName":"Sunrise Studio/Assets/Scripts/YarnCommands.cs","language":"csharp","async":false,"containsErrors":false,"location":{"start":{"line":129,"character":4},"end":{"line":137,"character":5}},"parameters":[]},{"yarnName":"loop_end","definitionName":"LoopEnd","fileName":"Sunrise Studio/Assets/Scripts/YarnCommands.cs","documentation":"<<loop_end 1>>: records the finished loop, starts the frozen world again, and loads Scene After Loop End.","language":"csharp","async":false,"containsErrors":false,"location":{"start":{"line":140,"character":4},"end":{"line":147,"character":5}},"parameters":[{"name":"loop","isParamsArray":false,"type":"number"}]}],"functions":[]}